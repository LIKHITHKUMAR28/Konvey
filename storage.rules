rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Organizations root directory - strictly isolated to target organization members
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.token.orgId == orgId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationIds.hasAny([orgId])
      );
      allow write: if request.auth != null && (
        request.auth.token.orgId == orgId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationIds.hasAny([orgId])
      ) && request.resource.size < 5 * 1024 * 1024 // 5MB cap per file (Spark plan safe)
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
