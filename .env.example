# ========================================================
# KONVEY — Firebase Environment Configuration Template
# ========================================================
# Copy this file to .env.local and populate with your Firebase
# Web App configuration values from the Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration.
#
# Free-Tier Constraint: Operating under Firebase Spark (No-Cost) Plan.
# ========================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=konvey-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=konvey
VITE_FIREBASE_STORAGE_BUCKET=konvey.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
